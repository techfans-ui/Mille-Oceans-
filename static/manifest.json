{
    "id": "/",
    "name": "Mille Oceans - Gestion de Stock",
    "short_name": "Mille Oceans",
    "description": "Application de gestion des stocks de boissons pour Mille Oceans",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "display_override": [
        "window-controls-overlay",
        "standalone",
        "minimal-ui",
        "browser"
    ],
    "background_color": "#023e8a",
    "theme_color": "#0077b6",
    "orientation": "any",
    "lang": "fr",
    "dir": "ltr",
    "categories": ["business", "productivity"],
    "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
    "prefer_related_applications": false,
    "related_applications": [],
    "handle_links": "preferred",
    "launch_handler": {
        "client_mode": "navigate-existing"
    },
    "edge_side_panel": {
        "preferred_width": 480
    },
    "share_target": {
        "action": "/produits",
        "method": "GET",
        "params": {
            "title": "q",
            "text": "q",
            "url": "q"
        }
    },
    "protocol_handlers": [
        {
            "protocol": "web+milleoceans",
            "url": "/produits?q=%s"
        }
    ],
    "file_handlers": [
        {
            "action": "/mouvements/entree",
            "accept": {
                "text/csv": [".csv"]
            }
        }
    ],
    "screenshots": [
        {
            "src": "/static/img/screenshot-wide.png",
            "sizes": "1280x720",
            "type": "image/png",
            "form_factor": "wide",
            "label": "Tableau de bord Mille Oceans"
        },
        {
            "src": "/static/img/screenshot-narrow.png",
            "sizes": "750x1334",
            "type": "image/png",
            "form_factor": "narrow",
            "label": "Vue mobile du tableau de bord"
        }
    ],
    "shortcuts": [
        {
            "name": "Tableau de bord",
            "url": "/dashboard",
            "icons": [{"src": "/static/img/icon-192.png", "sizes": "192x192"}]
        },
        {
            "name": "Produits",
            "url": "/produits",
            "icons": [{"src": "/static/img/icon-192.png", "sizes": "192x192"}]
        },
        {
            "name": "Entrée de stock",
            "url": "/mouvements/entree",
            "icons": [{"src": "/static/img/icon-192.png", "sizes": "192x192"}]
        }
    ],
    "icons": [
        {
            "src": "/static/img/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/static/img/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/static/img/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/static/img/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ]
}
